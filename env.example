# ──────────────────────────────────────────────────────────────
# Local development configuration — DO NOT commit this file
# ──────────────────────────────────────────────────────────────
# DATABRICKS_TOKEN is used in LOCAL DEV ONLY.
# In Databricks Apps (production), the per-user token is injected
# automatically via the X-Forwarded-Access-Token header.
# DATABRICKS_TOKEN is never set in app.yaml.
# ──────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapi-your-token-here   # local dev only — not used in Apps
TARGET_CATALOG=your_catalog
TARGET_SCHEMA=your_schema               # schema where dataeditor_* config tables live
